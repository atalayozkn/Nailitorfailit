%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 52e4a196ade8fa64b94cade3bdeb555c, type: 3}
  m_Name: Popup_Level01
  m_EditorClassIdentifier: Assembly-CSharp::InfoPopupData
  popupId: level01_intro
  pages:
  - title: Level 1 - Your first house
    body: 'Build the whole floor of a wooden house before the timer runs out.


      Every
      finished room gives you extra time and coins.'
    image: {fileID: 0}
  - title: Shops
    body: 'Shop stands sell useful items. Walk up to one and press <b>E</b> to buy
      it (you need enough coins):


      <b>Energy Drink</b> - refills your stamina.

      <b>Oil</b>
      - refuels a station''s generator.

      <b>Pet Food</b> - keeps your dog happy.'
    image: {fileID: 0}
  - title: Power your stations
    body: 'Every station runs on its own generator. When a station''s power bar is
      empty it stops working.


      Carry <b>Oil</b> to the station and press <b>E</b>
      to refuel it.'
    image: {fileID: 0}
  - title: Watch the road!
    body: Cars don't stop for builders. Look both ways before crossing - getting
      hit knocks you down and costs you precious time.
    image: {fileID: 0}
  - title: Move like a pro
    body: "Hold <b>Shift</b> to sprint and press <b>Space</b> to jump.\n\nMoving uses <b>stamina</b> - sprinting and carrying use it faster. Drink an <b>Energy Drink</b> to refill it."
    image: {fileID: 0}
  - title: You've got mail!
    body: "Now and then the <b>MailMan</b> drops a letter in your mailbox. Walk up to the mailbox and press <b>E</b> to collect it for <b>extra time</b>.\n\nKeep your dog happy - a grumpy dog chases the MailMan away before he can deliver."
    image: {fileID: 0}
