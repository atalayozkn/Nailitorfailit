  popupId: tutorial_intro
  pages:
  - title: Welcome to Nail It or Fail It!
    body: "You build houses, one floor tile at a time.\n\nThis short tutorial teaches the basics. Your dog needs a home, so you will build its <b>dog house</b>."
    image: {fileID: 0}
  - title: How to play
    body: "<b>W, A, S, D</b> - move.\n<b>E</b> - interact: pick things up, put them into machines, place and nail tiles.\n\nFollow the objective shown on screen. The highlighted spots and glowing items show where to go next."
    image: {fileID: 0}
